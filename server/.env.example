# Backend environment variables (copy to .env)
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
DATABASE_URL=postgresql://everyday:everyday@localhost:5432/everyday_ai
REDIS_URL=redis://localhost:6379
AI_PROVIDER=stub
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=10000
AI_ENABLED=false
NOTIFICATION_PROVIDER=stub
PILOT_CITY=Bengaluru
PILOT_AREAS=Indiranagar,Koramangala,HSR Layout,Whitefield
CURRENCY=INR
TIMEZONE=Asia/Kolkata
FEATURE_CLEANING=true
FEATURE_DRIVING=true
FEATURE_GARDENING=true
FEATURE_PAYMENTS=false
FEATURE_VOICE=false
FEATURE_TRAVEL=true