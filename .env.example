# Everyday AI Concierge — Environment variables
# Copy to .env and fill in values. Never commit real secrets.

# App
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Auth (change these in production)
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Database
DATABASE_URL=postgresql://everyday:everyday@localhost:5432/everyday_ai

# Redis / queue
REDIS_URL=redis://localhost:6379

# AI (provider-agnostic). Set AI_ENABLED=true only with real credentials.
AI_PROVIDER=stub
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=10000
AI_ENABLED=false

# Notifications (enabled only with real credentials + consent)
NOTIFICATION_PROVIDER=stub
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
MSG91_AUTH_KEY=

# File storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Pilot config
PILOT_CITY=Bengaluru
PILOT_AREAS=Indiranagar,Koramangala,HSR Layout,Whitefield
CURRENCY=INR
TIMEZONE=Asia/Kolkata

# Feature flags
FEATURE_CLEANING=true
FEATURE_DRIVING=true
FEATURE_GARDENING=true
FEATURE_PAYMENTS=false
FEATURE_VOICE=false
FEATURE_TRAVEL=true